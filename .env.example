# Copy to .env for local development. Never commit .env.
# Variables marked (Pn) are used from that build phase onward.

# --- Runtime ---
NODE_ENV=development
PORT=5000
# Exact client origin (no trailing slash). Production: https://<your-client>.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# --- MongoDB (P2) ---
MONGODB_URI=
MONGODB_DB_NAME=wedora

# --- Better Auth JWT verification (P2) ---
# These point at the Next.js client, which issues the JWTs.
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000

# --- Stripe, test mode (P6) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
